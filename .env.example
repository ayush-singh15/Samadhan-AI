# Samadhan AI Environment Variables

# --- General ---
NODE_ENV=development
PORT=5000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samadhan_db?schema=public"

# --- Redis (Caching & BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET=super_secret_jwt_key_samadhan_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key_samadhan_2026
JWT_REFRESH_EXPIRES_IN=30d

# --- AI Service Microservice ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# --- Frontend Web ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_AI_SERVICE_URL=http://localhost:8000

# --- Storage / Uploads ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# --- Email / Notifications (SMTP Setup) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
FROM_EMAIL=notifications@samadhan.gov.in
